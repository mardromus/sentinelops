# --- AI agent (any OpenAI-compatible API; leave empty for the offline agent) ---
SENTINELOPS_LLM_API_KEY=
SENTINELOPS_LLM_BASE_URL=https://api.groq.com/openai/v1
SENTINELOPS_LLM_MODEL=llama-3.3-70b-versatile

# --- autonomy: 0 observe, 1 advise (comments + suggested fixes), 2 assist (draft fix PRs),
#     3 autonomous (ready-for-review PRs for low-risk verified fixes). The agent never merges. ---
SENTINELOPS_AUTONOMY=1

# --- GitHub integration (webhooks, PR comments, fix pull requests) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# --- vulnerability database: online lookups against OSV.dev (set 0 to stay offline) ---
SENTINELOPS_OSV=1

# --- server ---
PORT=3000
SENTINELOPS_DATA_DIR=./data
# required for POST endpoints when set (Authorization: Bearer <token>)
SENTINELOPS_API_TOKEN=
# comma-separated directories the HTTP API may scan (default: the working directory)
SENTINELOPS_SCAN_ROOTS=
# base URL used in commit status links
SENTINELOPS_PUBLIC_URL=http://localhost:3000
# fail threshold for the CI gate: critical | high | medium | low
SENTINELOPS_FAIL_ON=high
