            {
              "id": "dep.CVE-2022-31129",
              "name": "depCVE202231129",
              "shortDescription": {
                "text": "Vulnerable dependency (CVE-2022-31129)"
              },
              "fullDescription": {
                "text": "moment 2.29.1 is affected by CVE-2022-31129 (Inefficient RFC2822 parsing leads to ReDoS)."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2022-31129",
