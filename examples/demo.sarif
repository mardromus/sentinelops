              "shortDescription": {
                "text": "Vulnerable dependency (CVE-2022-23540)"
              },
              "fullDescription": {
                "text": "jsonwebtoken 8.5.1 is affected by CVE-2022-23540 (Signature validation bypass through insecure default algorithm in jwt.verify)."
              },
